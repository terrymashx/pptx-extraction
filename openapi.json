{
  "openapi": "3.0.1",
  "info": {
    "title": "PPTX Extractor",
    "description": "Extracts structured text and tables from a PowerPoint file (.pptx). Returns a JSON document with per-slide content suitable for further processing (e.g., generating a website).",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://<YOUR_FUNCTION_APP_NAME>.azurewebsites.net/api",
      "description": "Azure Function App"
    }
  ],
  "paths": {
    "/extract-pptx": {
      "post": {
        "operationId": "extractPptx",
        "summary": "Extract content from a PowerPoint file",
        "description": "Upload a .pptx file and receive a structured JSON document containing each slide's title, text blocks, and tables.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "The PowerPoint (.pptx) file to extract content from."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Extracted slide content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractionResult"
                }
              }
            }
          },
          "400": {
            "description": "Missing file in request"
          },
          "415": {
            "description": "Unsupported file type"
          },
          "500": {
            "description": "Extraction failed"
          }
        },
        "security": [
          {
            "functionKey": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ExtractionResult": {
        "type": "object",
        "properties": {
          "filename": { "type": "string" },
          "slide_count": { "type": "integer" },
          "slides": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Slide" }
          }
        }
      },
      "Slide": {
        "type": "object",
        "properties": {
          "slide_number": { "type": "integer" },
          "title": { "type": "string", "nullable": true },
          "text_blocks": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "functionKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-functions-key"
      }
    }
  }
}
